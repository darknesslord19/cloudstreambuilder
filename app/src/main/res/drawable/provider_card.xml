<?xml version="1.0" encoding="utf-8"?>
<!-- A provider in the list of home page sources: a slim card, outlined when chosen,
     white outline when the remote is on it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
            <stroke android:width="2dp" android:color="?attr/white" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/iconGrayBackground" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
        </shape>
    </item>
</selector>
