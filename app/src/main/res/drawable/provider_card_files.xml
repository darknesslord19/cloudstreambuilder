<?xml version="1.0" encoding="utf-8"?>
<!-- A plugin loaded from a file in the list of home page sources: the card with a violet edge -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
            <stroke android:width="2dp" android:color="?attr/white" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#2A7B4DFF" android:endColor="#0019C3E6" />
            <stroke android:width="1dp" android:color="#557B6CFF" />
        </shape>
    </item>
</selector>
