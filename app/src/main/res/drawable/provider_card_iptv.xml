<?xml version="1.0" encoding="utf-8"?>
<!-- An IPTV list in the list of home page sources: the card with a blue edge -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
            <stroke android:width="2dp" android:color="?attr/white" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/boxItemBackground" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#262F7BFF" android:endColor="#0000C8FF" />
            <stroke android:width="1dp" android:color="#5533A3FF" />
        </shape>
    </item>
</selector>
