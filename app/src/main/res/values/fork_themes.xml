    <color name="MidnightBlueAccentDark">#2A5FCC</color>
    <color name="MidnightBlueOnAccent">#0B1220</color>

    <style name="MidnightBlueMode">
        <item name="primaryGrayBackground">@color/MidnightBluePrimaryGrayBackground</item>
        <item name="primaryBlackBackground">@color/MidnightBlueBitDarkerGrayBackground</item>
        <item name="iconGrayBackground">@color/MidnightBlueGrayBackground</item>
        <item name="boxItemBackground">@color/MidnightBlueItemBackground</item>
        <item name="textColor">@color/MidnightBlueTextColor</item>
        <item name="grayTextColor">@color/MidnightBlueIconColor</item>
        <item name="iconColor">@color/MidnightBlueIconColor</item>
        <item name="white">@color/MidnightBlueTextColor</item>
        <item name="black">@color/MidnightBlueBitDarkerGrayBackground</item>
        <item name="colorOnPrimary">@color/MidnightBlueTextColor</item>
    </style>

    <style name="OverlayPrimaryColorThemeMidnightBlue">
        <item name="colorPrimary">@color/MidnightBlueAccent</item>
        <item name="android:colorPrimary">@color/MidnightBlueAccent</item>
        <item name="colorPrimaryDark">@color/MidnightBlueAccentDark</item>
        <item name="colorAccent">@color/MidnightBlueAccent</item>
        <item name="colorOnPrimary">@color/MidnightBlueOnAccent</item>
        <item name="android:colorAccent">@color/MidnightBlueAccent</item>
    </style>

