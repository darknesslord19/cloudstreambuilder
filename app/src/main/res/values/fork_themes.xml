    <!-- Ten extra app themes. Each one has a matching accent colour, used while the
         "primary colour" setting is left on its default. -->

    <!-- Gece Mavisi -->
    <color name="MidnightBluePrimaryGrayBackground">#1A2438</color>
    <color name="MidnightBlueBitDarkerGrayBackground">#0B1220</color>
    <color name="MidnightBlueGrayBackground">#111A2B</color>
