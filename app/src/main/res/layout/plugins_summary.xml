<?xml version="1.0" encoding="utf-8"?>
<!-- How many plugins of the repository are installed, with "install all" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plugins_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/plugin_summary_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/plugins_summary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/grayTextColor"
            android:textSize="13sp"
            tools:text="8 / 50 eklenti yüklü" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/plugins_summary_button"
            style="@style/WhiteButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="0dp"
            android:focusable="true"
            android:nextFocusUp="@id/tvtypes_chips"
            android:nextFocusDown="@id/plugin_recycler_view"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/plugins_install_all"
            android:textSize="13sp"
            app:icon="@drawable/netflix_download"
            app:iconSize="18dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/plugins_summary_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/primaryGrayBackground"
        app:trackCornerRadius="3dp"
        app:trackThickness="4dp"
        tools:visibility="visible" />
</LinearLayout>
