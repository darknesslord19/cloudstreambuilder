<?xml version="1.0" encoding="utf-8"?>
<!-- The main settings screen: groups of rows on rounded cards, coloured by the app theme -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/settings_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/settings_profile_card"
                style="@style/SettingsCard"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/settings_profile"
                    style="@style/SettingsRow"
                    android:minHeight="96dp"
                    android:paddingStart="18dp"
                    android:nextFocusDown="@id/settings_account_info">

                    <FrameLayout
                        android:id="@+id/settings_profile_ring"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="18dp"
                        android:padding="4dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="?attr/primaryBlackBackground"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/settings_profile_pic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/account"
                                android:scaleType="centerCrop"
                                tools:src="@drawable/profile_bg_orange" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            android:id="@+id/settings_profile_text"
                            style="@style/SettingsRowTitle"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textSize="20sp"
                            tools:text="Quick Brown Fox" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/active_profile" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- Only shown while the access list of this build is switched on -->
            <LinearLayout
                android:id="@+id/settings_account_card"
                style="@style/SettingsCard"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/settings_account_info"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_profile"
                    android:nextFocusDown="@id/settings_general">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/account_circle_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/access_account" />

                        <TextView
                            android:id="@+id/settings_account_info_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="Name • 54 years 94 days left" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_card_main"
                style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/settings_general"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_account_info"
                    android:nextFocusDown="@id/settings_player">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/build_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/category_general" />

                        <TextView
                            android:id="@+id/settings_general_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_player"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_general"
                    android:nextFocusDown="@id/settings_providers">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/play_arrow_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/category_player" />

                        <TextView
                            android:id="@+id/settings_player_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_providers"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_player"
                    android:nextFocusDown="@id/settings_ui">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baseline_dns_24" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/category_providers" />

                        <TextView
                            android:id="@+id/settings_providers_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_ui"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_providers"
                    android:nextFocusDown="@id/settings_updates">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/format_paint_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/category_ui" />

                        <TextView
                            android:id="@+id/settings_ui_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_card_data"
                style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/settings_updates"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_ui"
                    android:nextFocusDown="@id/settings_credits">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/mobile_arrow_down_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/category_updates" />

                        <TextView
                            android:id="@+id/settings_updates_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_credits"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_updates"
                    android:nextFocusDown="@id/settings_extensions">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/encrypted_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/category_account" />

                        <TextView
                            android:id="@+id/settings_credits_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_card_extensions"
                style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/settings_extensions"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_credits"
                    android:nextFocusDown="@id/settings_about">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/extension_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/extensions" />

                        <TextView
                            android:id="@+id/settings_extensions_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_card_about"
                style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/settings_about"
                    style="@style/SettingsRow"
                    android:nextFocusUp="@id/settings_extensions">

                    <com.lagradost.cloudstream3.fork.IconBox
                        style="@style/SettingsRowIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/code_24px" />

                    <LinearLayout style="@style/SettingsRowTexts">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/developer" />

                        <TextView
                            android:id="@+id/settings_about_summary"
                            style="@style/SettingsRowSummary"
                            tools:text="First, Second, Third" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_version_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="13sp"
                    tools:text="0.0.0" />

                <TextView
                    android:id="@+id/delimiter0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="?attr/grayTextColor" />

                <TextView
                    android:id="@+id/commit_hash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="13sp"
                    tools:text="1234567" />

                <TextView
                    android:id="@+id/delimiter1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="?attr/grayTextColor" />

                <TextView
                    android:id="@+id/build_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="13sp"
                    tools:text="21/03/2024 09:02 pm" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
