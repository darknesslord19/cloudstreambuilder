<?xml version="1.0" encoding="utf-8"?>
<!-- Plus: what this build adds. Each part opens its settings in a menu from the bottom -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:icon="@drawable/format_paint_24px"
        android:key="fork_plus_sheet_themes"
        android:summary="@string/tp_summary"
        android:title="@string/tp_title" />

    <Preference
        android:icon="@drawable/animation_24px"
        android:key="fork_plus_sheet_looks"
        android:summary="@string/plus_looks_des"
        android:title="@string/plus_looks" />

    <Preference
        android:icon="@drawable/home_alt"
        android:key="fork_plus_sheet_home"
        android:summary="@string/plus_home_des"
        android:title="@string/plus_home" />

    <Preference
        android:icon="@drawable/categories_24px"
        android:key="fork_plus_sheet_categories"
        android:summary="@string/plus_categories_des"
        android:title="@string/categories" />

    <Preference
        android:icon="@drawable/ic_fork_image_24"
        android:key="fork_plus_sheet_tmdb"
        android:summary="@string/tmdb_des"
        android:title="@string/tmdb_title" />

    <Preference
        android:icon="@drawable/ic_baseline_subtitles_24"
        android:key="fork_plus_sheet_subtitles"
        android:summary="@string/plus_subtitles_des"
        android:title="@string/player_subtitles_settings" />

    <Preference
        android:icon="@drawable/extension_24px"
        android:key="fork_plus_sheet_extensions"
        android:summary="@string/plus_extensions_des"
        android:title="@string/extensions" />
</PreferenceScreen>
